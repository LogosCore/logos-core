# logos-guacd: guacamole-server, built from its release commit with Apache's
# own Dockerfile (Dockerfile here: its source patched, patches/), against
# FreeRDP 3; every library it builds pinned to an exact tag. publish-guacd.yml builds the image from
# these; docker-compose.yml's guacd build and the Helm chart's guacd.image
# say the same, and the web app's vendored Guacamole client is this
# release (frontend/src/vendor/guacamole/guacd-pins.test.ts checks all
# four agree). README.md says why, and how to move them.
GUACAMOLE_SERVER_VERSION=1.6.0
GUACAMOLE_SERVER_COMMIT=1f664e08feae6e7d15d8146b78acab2e6fb470ae
FREERDP_VERSION=3
WITH_FREERDP=3.30.0
WITH_LIBSSH2=libssh2-1.11.1
WITH_LIBTELNET=0.23
WITH_LIBVNCCLIENT=LibVNCServer-0.9.15
WITH_LIBWEBSOCKETS=v4.3.5
# Our build of those: one up for each change of patches/ or the Dockerfile,
# so an image of another build never has the same tag.
LOGOS_REVISION=4
